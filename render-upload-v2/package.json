{
  "name": "blade-rivals",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "server": "node server/server.js",
    "desktop": "vite build && npx electron .",
    "build:exe": "vite build && npx electron-builder --win portable"
  },
  "build": {
    "appId": "com.bladerivals.game",
    "productName": "BladeRivals",
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "vite": "^6.0.0"
  }
}
